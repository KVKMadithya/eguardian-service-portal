{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "Chart": "readonly"
  },
  "extends": [
    "eslint:recommended",
    "plugin:security/recommended-legacy"
  ],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "security/detect-object-injection": "off"
  }
}
